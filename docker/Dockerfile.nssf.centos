#---------------------------------------------------------------------
#
# Dockerfile for the OpenAirInterface NSSF service
#   Valid for CentOS Stream 10
#
#---------------------------------------------------------------------

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------

FROM quay.io/centos/centos:stream10 AS oai-nssf-builder

ENV IS_DOCKERFILE=1

# meson and ninja-build come from CRB; EPEL is enabled for the packages
# build_helper.nssf pulls from it. The rest are in BaseOS/AppStream.
RUN dnf config-manager --set-enabled crb && \
    dnf install epel-release -y && \
    dnf update -y && \
    # Log the exact OS release used for the build.
    cat /etc/os-release && \
    dnf install -y \
        psmisc \
        git \
        diffutils \
        libasan \
        wget \
        file && \
    # Libraries built from source are installed under /usr/local, which is not
    # on the default loader path on EL. This is also needed for the ldd check.
    echo "/usr/local/lib" > /etc/ld.so.conf.d/local-lib.conf && \
    echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local-lib.conf

# Git configuration
RUN git config --global https.postBuffer 123289600 && \
    git config --global http.sslverify false

# Copy source code
WORKDIR /openair-nssf
COPY . /openair-nssf

# Install and Build NSSF
WORKDIR /openair-nssf/build/scripts
RUN ./build_nssf --install-deps --force
RUN ./build_nssf --clean --Verbose --build-type Release --jobs && \
    ldd /openair-nssf/build/nssf/build/nssf && \
    mv /openair-nssf/build/nssf/build/nssf /openair-nssf/build/nssf/build/oai_nssf

FROM mikefarah/yq:latest AS yq-source

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM quay.io/centos/centos:stream10-minimal AS oai-nssf
ENV TZ=Europe/Paris

RUN microdnf update -y && \
    microdnf install -y \
# Timezone data, and debugging/networking utilities
      tzdata \
      procps-ng \
      psmisc \
      net-tools \
      iputils \
      tcpdump \
# Runtime dependencies of oai_nssf
      libicu \
      boost \
      libevent \
      findutils && \
    microdnf clean all -y && \
    rm -rf /var/cache/yum /var/cache/dnf

# Copy executable and generated libraries
WORKDIR /openair-nssf/bin
COPY --from=oai-nssf-builder \
    /openair-nssf/build/nssf/build/oai_nssf \
    /openair-nssf/scripts/healthcheck.sh \
    ./
COPY --from=yq-source /usr/bin/yq /usr/bin

# Only the libraries built from source; the rest come from the packages above.
# pistache (meson) and nghttp2 (autotools) install into lib, the CMake-built
# spdlog, fmt and yaml-cpp into lib64.
COPY --from=oai-nssf-builder \
    /usr/local/lib/libpistache.so* \
    /usr/local/lib/libnghttp2_asio.so \
    /usr/local/lib/libnghttp2_asio.so.1 \
    /usr/local/lib64/libspdlog.so \
    /usr/local/lib64/libfmt.so \
    /usr/local/lib64/libyaml-cpp.so.0.* \
    /usr/lib64/

RUN ldconfig && \
    ldd /openair-nssf/bin/oai_nssf && \
    # ldd exits 0 even when a library is missing, so check its output
    ! ldd /openair-nssf/bin/oai_nssf | grep -q 'not found'

# Copy template configuration files; the configuration folder will be flat
WORKDIR /openair-nssf/etc
COPY --from=oai-nssf-builder \
    /openair-nssf/etc/config.yaml \
    /openair-nssf/etc/nssf_slice_config.yaml \
    ./

WORKDIR /openair-nssf

# Expose ports
EXPOSE 80/tcp 8080/tcp

# Configure healthcheck
HEALTHCHECK --interval=10s \
            --timeout=15s \
            --retries=6 \
    CMD /openair-nssf/bin/healthcheck.sh

CMD ["/openair-nssf/bin/oai_nssf", "-c", "/openair-nssf/etc/config.yaml", "-o"]
